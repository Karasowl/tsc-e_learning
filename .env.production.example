# Production .env for the VPS stack (docker-compose.prod.yml).
# Copy to .env on the VPS and fill with real values. NEVER commit the real .env.
# This stack is VPS-agnostic: only this file changes between providers/servers.

NODE_ENV=production

# --- Public hostnames ---
# API domain (points to this VPS, served over HTTPS by Caddy). DNS: A record
# api.capacita.tscseguridadprivada.com.mx -> <VPS_IP>.
API_DOMAIN=api.capacita.tscseguridadprivada.com.mx
API_PUBLIC_URL=https://api.capacita.tscseguridadprivada.com.mx
# Web public URL = the Vercel deployment / final LMS domain. Used for CORS.
WEB_PUBLIC_URL=https://capacita.tscseguridadprivada.com.mx

# --- API ---
API_PORT=4000
JWT_SECRET=CHANGE-ME-long-random-secret-min-32-chars

# --- PostgreSQL (db service + DATABASE_URL must agree) ---
POSTGRES_USER=tsc_capacita
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=tsc_capacita
# Inside the compose network the DB host is the service name `db` on port 5432.
DATABASE_URL=postgresql://tsc_capacita:CHANGE-ME-strong-db-password@db:5432/tsc_capacita

# --- Storage (local VPS volume; abstracted for future MinIO/R2/S3) ---
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage

# --- Email (Hostinger SMTP) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=capacitacion@tscseguridadprivada.com.mx
SMTP_PASSWORD=CHANGE-ME-smtp-password
SMTP_FROM="TSC Capacita <capacitacion@tscseguridadprivada.com.mx>"

# Diploma background for the printable HTML diploma. The server-side PDF uses the
# bundled asset, so this is only for the HTML view. Point it at the web-served image.
CERTIFICATE_BACKGROUND_URL=https://capacita.tscseguridadprivada.com.mx/diploma-fondo-v4.jpg

# --- Notifications worker ---
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_WORKER_INTERVAL_MS=60000
NOTIFICATIONS_WORKER_BATCH=25

# NOTE: NEXT_PUBLIC_API_URL is NOT set here. The web runs on Vercel; set
# NEXT_PUBLIC_API_URL=https://api.capacita.tscseguridadprivada.com.mx in the
# Vercel project environment variables instead.
