# Caddy reverse proxy for the TSC Capacita API.
# Automatic HTTPS (Let's Encrypt) for the API domain. Portable: no host-specific
# certificate management — Caddy provisions and renews certs on any VPS.
#
# {$API_DOMAIN} is read from the environment (set in .env, passed by compose).

{$API_DOMAIN} {
	encode gzip
	reverse_proxy api:4000
}
