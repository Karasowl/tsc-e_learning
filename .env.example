# Shared
NODE_ENV=development

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://tsc_capacita:tsc_capacita_dev@localhost:5433/tsc_capacita
JWT_SECRET=replace-with-a-long-random-secret
# Vigencia del token de sesión (default 30d). Formato de expiración JWT: 12h, 7d, 30d...
JWT_EXPIRES_IN=30d
# Login con Google (opcional). Client ID de OAuth de Google Cloud. El API valida
# el id_token contra este client. Si se deja vacío, el login con Google queda apagado.
GOOGLE_CLIENT_ID=
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage

# SMTP. Start with Hostinger SMTP if available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TSC Capacita <capacitacion@tscseguridadprivada.com.mx>"
CERTIFICATE_BACKGROUND_URL=

# Notifications worker. Auto-sends pending notification logs through SMTP.
# Only runs when SMTP is configured. Set to false to deliver elsewhere
# (separate process or external cron hitting POST /notifications/process).
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_WORKER_INTERVAL_MS=60000
NOTIFICATIONS_WORKER_BATCH=25

# Optional future S3-compatible storage. Leave empty for v1 local/VPS storage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
# Login con Google en el frontend (opcional). Mismo Client ID que GOOGLE_CLIENT_ID.
# El botón "Continuar con Google" solo aparece si esta variable está definida.
# Nota: Next.js lee su env desde apps/web (apps/web/.env.local), no desde la raíz.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
