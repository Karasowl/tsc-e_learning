# Next.js lee las variables desde este directorio (apps/web), no desde la raíz
# del monorepo. Copia este archivo a apps/web/.env.local para desarrollo.

# URL pública del API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Login con Google (opcional). Client ID de OAuth de Google Cloud, el mismo que
# GOOGLE_CLIENT_ID del API. El botón "Continuar con Google" solo aparece si esta
# variable está definida.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
